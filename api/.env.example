# Database — local Postgres via Docker Compose
# Run `pnpm db:setup` to start the container and run migrations
DATABASE_URL=postgres://web_app_starter:password@localhost:53437/web_app_starter

# Better Auth — generate a random 32-char secret: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Set Authorized redirect URI to: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional — API port (default: 3001)
# PORT=3001

# Optional — comma-separated production origins for CORS checks (leave empty for dev)
# Bare domains are normalized to https:// origins.
# ALLOWED_ORIGINS=https://yourdomain.com,https://staging.yourdomain.com

# Optional — trust x-forwarded-for / x-real-ip for rate limiting only behind a trusted proxy
# TRUST_PROXY_HEADERS=true

# Optional — disable rate limiting in development (default: false)
# RATE_LIMIT_DISABLED=true
